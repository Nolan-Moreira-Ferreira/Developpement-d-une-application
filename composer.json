{
  "name": "more0292/sae2-01",
  "description": "Développement d’une application",
  "type": "project",
  "license": "WTFPL",
  "autoload": {
    "psr-4":{
      "": "src/"
    }
  },
  "authors": [
    {
      "name": "Moreira Ferreira Nolan",
      "email": "nolan.moreira-ferreira@etudiant.univ-reims.fr"
    }
  ],
  "require": {
    "ext-pdo": "*",
    "ext-gd": "*"
  },
  "scripts": {
    "start:linux": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run-server.sh"
    ],
    "start:windows": [
      "Composer\\Config::disableProcessTimeout",
      "bin/run-server.bat"
    ],
    "start": [
      "@start:linux"
    ],
    "test:cs":
    [
      "php vendor/bin/php-cs-fixer fix --dry-run"
    ],
    "fix:cs":
    [
      "php vendor/bin/php-cs-fixer fix"
    ]
  }
}
